  <Import Project="$(VCTargetsPath)Microsoft.Cpp.targets" />
  <!-- Generate the manifest before compilation so both IDE and command-line builds share version.h. -->
  <Target Name="GenerateVersionManifest" BeforeTargets="PrepareForBuild"
          Inputs="$(ProjectRoot)src\as_java_re\version.h;$(ProjectRoot)resources\AlienShooter.manifest;$(MSBuildProjectFullPath)"
          Outputs="$(IntDir)AlienShooter.manifest">
    <MakeDir Directories="$(IntDir)" />
    <Copy SourceFiles="$(ProjectRoot)resources\AlienShooter.manifest" DestinationFiles="$(IntDir)AlienShooter.manifest" />
    <XmlPoke XmlInputPath="$(IntDir)AlienShooter.manifest"
             Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version"
             Value="$(ApplicationVersion)" />
    <Message Importance="high" Text="Application version: $(ApplicationVersion)" />
  </Target>
  <Target Name="CopyRuntime" AfterTargets="Build">
    <ItemGroup>
      <RuntimeDll Include="$(ProjectRoot)src\3rdparty\fluidsynth\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyGameAssets" AfterTargets="CopyRuntime">
    <ItemGroup>
      <GameAsset Include="$(ProjectRoot)assets\**\*" Exclude="$(ProjectRoot)assets\audio\ogg\**\*" />
      <SynthAsset Include="$(ProjectRoot)src\3rdparty\generaluser\GeneralUser-GS.sf2;$(ProjectRoot)src\3rdparty\generaluser\LICENSE.txt" />
      <GameDocument Include="$(ProjectRoot)docs\player-guide.md" />
    </ItemGroup>
    <Copy SourceFiles="@(GameAsset)" DestinationFiles="@(GameAsset-&gt;'$(OutDir)assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SynthAsset)" DestinationFolder="$(OutDir)assets\audio\synth" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameDocument)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
